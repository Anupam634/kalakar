# --- required ---
PORT=3100
# Public HTTPS address of this server. Instagram downloads media from PUBLIC_URL/media/... and
# redirects OAuth back to PUBLIC_URL/api/instagram/callback. Use a tunnel (cloudflared/ngrok/Tailscale Funnel) in dev.
PUBLIC_URL=http://localhost:3100
# 32+ random characters (encrypts Instagram tokens). Generate: openssl rand -base64 36
APP_SECRET=

# --- AI writing (Claude). Without it, posts are written from templates (English only). ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- AI scenes (optional). Gemini is preferred when both are set. IMAGE_PROVIDER=auto|gemini|openai|none ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_PROVIDER=auto

# --- Voiceover (any one). Sarvam is used first for Indian languages, ElevenLabs first for English. ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Instagram (Meta app with "Instagram API with Instagram Login") ---
IG_APP_ID=
IG_APP_SECRET=
IG_GRAPH_VERSION=v24.0
# 1 = users can connect a simulated account to try the full flow without Meta
ALLOW_DEMO_INSTAGRAM=1

FREE_CREDITS=60

# Unsplash real stock photos (unsplash.com/developers). Only the Access Key is needed.
UNSPLASH_ACCESS_KEY=

# Instagram, new Meta apps (Unified login): Meta App ID + App secret (App settings > Basic) and the Configuration ID
# from Use cases > Manage messaging & content on Instagram > API setup with Unified login.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v27.0
